<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#991A2229" />
            <stroke android:width="1dp" android:color="#3356D6C9" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#263B3E" />
            <stroke android:width="1dp" android:color="#AA56D6C9" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#1A2229" />
            <stroke android:width="1dp" android:color="#6656D6C9" />
        </shape>
    </item>
</selector>
