<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.biometrics"
        android:required="false" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:name=".VaultApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:taskAffinity="" />
        <activity
            android:name=".EntryActivity"
            android:exported="false"
            android:taskAffinity="" />
        <activity
            android:name=".RunEntryActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:taskAffinity="" />
        <activity
            android:name=".BackupActivity"
            android:exported="false"
            android:taskAffinity="" />
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:taskAffinity="" />
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".WidgetCommandPickerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="" />

        <receiver
            android:name=".AutomationReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="${applicationId}.RUN_ENTRY" />
            </intent-filter>
        </receiver>

        <!-- Exported so the Termux bootstrap can return an authenticated, one-time completion token.
             CompletionReceiver rejects every other action, untrusted installation, and invalid/replayed token. -->
        <receiver
            android:name=".CompletionReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver" />

        <receiver
            android:name=".CommandWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/command_widget_info" />
        </receiver>
    </application>

</manifest>
